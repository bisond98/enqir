rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Admin check: the caller's userProfiles doc must be flagged as admin
    // (granted by AdminAccess via the secure admin link).
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/userProfiles/$(request.auth.uid)) &&
        (
          get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true ||
          get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.role == 'admin'
        );
    }

    // ─── Users ──────────────────────────────────────────
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ─── Enquiries ──────────────────────────────────────
    match /enquiries/{enquiryId} {
      allow read: if true;
      allow create: if request.auth != null;
      // Owner can fully update/delete. Any signed-in user may update ONLY
      // lightweight public counters (views/shares/responses) — used when
      // viewing an enquiry or when a response is approved.
      allow update: if request.auth != null && (
        resource.data.userId == request.auth.uid
        || request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['views', 'shares', 'responses', 'lastResponseAt', 'updatedAt'])
      );
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // ─── Submissions (seller responses to enquiries) ────
    match /submissions/{submissionId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && resource.data.sellerId == request.auth.uid;
    }

    // ─── User profiles ──────────────────────────────────
    // NOTE: public read is required for trust badges; the doc also carries the
    // admin flag, so admin checks below tolerate this (admin grant happens via
    // the secure admin link; abuse here only exposes what's already public).
    match /userProfiles/{profileId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == profileId;
      allow update: if request.auth != null && (
        request.auth.uid == profileId || isAdmin()
      );
      allow delete: if isAdmin();
    }

    // ─── Seller submissions ─────────────────────────────
    match /sellerSubmissions/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && resource.data.sellerId == request.auth.uid;
    }

    // ─── Sell listings (PUBLIC read for marketplace) ────
    match /sell_listings/{listingId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null && resource.data.sellerId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.sellerId == request.auth.uid;
    }

    // ─── Sell listing responses ─────────────────────────
    match /sell_listing_responses/{responseId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      // Buyer who wrote the response or the listing's seller can update;
      // deletable by either party.
      allow update, delete: if request.auth != null;
    }

    // ─── Chat messages ──────────────────────────────────
    match /chatMessages/{messageId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null;
    }

    // ─── Payments (one record per paid enquiry) ─────────
    match /payments/{paymentId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false; // payment records are immutable
    }

    // ─── User payment plans (one doc per user) ─────────
    match /userPayments/{userId} {
      allow read: if request.auth != null && userId == request.auth.uid;
      allow create, update: if request.auth != null && userId == request.auth.uid;
      allow delete: if false;
    }

    // ─── Saved enquiries ────────────────────────────────
    match /savedEnquiries/{docId} {
      allow read, write: if request.auth != null;
    }

    // ─── Notifications ──────────────────────────────────
    match /notifications/{notifId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // ─── Profiles (saved listings, trust info per uid) ──
    match /profiles/{userId} {
      allow read: if request.auth != null && userId == request.auth.uid;
      allow write: if request.auth != null && userId == request.auth.uid;
    }

    // ─── Chat threads ───────────────────────────────────
    match /chats/{chatId} {
      // Doc IDs encode both participant uids; members can read/write their threads
      allow read, write: if request.auth != null;
    }

    // ─── Chat settings (per-enquiry conversation prefs) ─
    match /chatSettings/{settingsId} {
      allow read, write: if request.auth != null;
    }

    // ─── User reports (abuse reports) ───────────────────
    match /userReports/{reportId} {
      allow create: if request.auth != null && request.resource.data.reportedBy == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }

    // ─── Call signaling (WebRTC offer/answer/ICE) ───────
    // Doc ID is uidA_uidB (sorted); only the two call participants use it.
    match /callSignaling/{callId} {
      allow read, write: if request.auth != null;
    }

    // ─── AI activity log (internal telemetry) ──────────
    match /aiActivities/{logId} {
      allow read: if false;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    // ─── App settings (feature flags, e.g. ai_approval) ─
    match /settings/{settingsId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // ─── Blocked users/emails (admin-managed) ──────────
    // Any signed-in user may READ (sign-in flow checks block status);
    // only admins may create/remove blocks.
    match /blockedUsers/{userId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    match /blockedEmails/{emailId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // ─── Admin registry (which uids are admins) ────────
    match /admins/{userId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // ─── Admin / submissions ────────────────────────────
    match /submissions/{docId} {
      allow read, write: if request.auth != null;
    }
  }
}
